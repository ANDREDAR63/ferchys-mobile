<file path="pubspec.yaml">
name: ferchys_mobile
description: "App móvil de Ferchy's Postres — catálogo, carrito, pedidos y dashboards por rol."
publish_to: 'none'

# Version de la app. En Android el primer numero es versionName y el segundo (+1) es versionCode.
version: 1.0.0+1

environment:
  sdk: ^3.13.4

dependencies:
  flutter:
    sdk: flutter

  # Iconos con estilo iOS (CupertinoIcons). Se usa en los controles de la barra superior.
  cupertino_icons: ^1.0.8

  # Cliente HTTP para hablar con la API de Laravel. Reemplaza al `fetch` que usa la version web.
  http: ^1.6.0

  # Estado global. Es el equivalente al Context de React de la version web:
  # sube un objeto a un Provider y cualquier widget lo lee con context.watch<T>().
  provider: ^6.1.5+1

  # Almacenamiento local en disco (sustituye al localStorage del navegador).
  # Lo usamos para el token, el usuario y la URL del backend.
  shared_preferences: ^2.5.5

  # Formato de fechas y numeros segun la configuracion regional de Colombia.
  intl: ^0.20.3

dev_dependencies:
  flutter_test:
    sdk: flutter

  # Reglas de analisis de codigo que recomienda Flutter. Se activan en analysis_options.yaml.
  flutter_lints: ^6.0.0

flutter:
  # Incluye la fuente de Material Icons, necesaria para los iconos de Icons.*.
  uses-material-design: true

  # Fotos de los productos. Son las mismas que usa la version web y se
  # asignan por nombre de producto en lib/utils/imagenes_producto.dart.
  assets:
    - assets/images/
</file>

</files>
